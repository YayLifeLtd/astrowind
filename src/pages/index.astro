---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Note from '~/components/widgets/Note.astro';
import { Image } from 'astro:assets';
import Contact from '~/components/widgets/Contact.astro';
import type { ImageMetadata } from 'astro';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>('~/assets/images/gallery/*.{jpeg,jpg,png,webp}');

const galleryItems = await Promise.all(
  Object.keys(imageFiles).map(async (path) => {
    const file = await imageFiles[path]();
    const fileName = path.split('/').pop()?.split('.')[0] || 'art';
    
    return {
      id: fileName,
      title: fileName.replace(/-/g, ' ').replace(/_/g, ' '),
      src: file.default, // <--- No more "as any" here!
    };
  })
);

const metadata = {
  title: 'QSuper.art — Time and Trust',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'View Gallery', href: '#gallery' },
      { text: 'Concept', href: '#philosophy' },
    ]}
    image={{ src: '~/assets/images/hero-night-sky.jpg', alt: 'QSuper Art' }}
  >
    <Fragment slot="title">QSuper.art</Fragment>
    <Fragment slot="subtitle">
      An art project about time, trust, and money we are not meant to touch.
    </Fragment>
  </Hero>

<div id="philosophy">
  <Note title="Philosophy:" description="The distance between intent and realization." />
</div>

  <Features2
    id="gallery"
    title="Visual Exposures"
    subtitle="Click an image to view the full exposure."
    items={galleryItems.map((item) => ({
      title: item.title,
      image: { src: item.src, alt: item.title },
      callToAction: { href: `#${item.id}` },
    }))}
  />

  {galleryItems.map((item) => (
    <div id={item.id} class="lightbox-overlay">
      <a href="#gallery" class="lightbox-bg-close"></a>
      <div class="lightbox-wrapper">
        <Image src={item.src} alt={item.title} class="lightbox-img" width={1600} height={900} />
        <div class="lightbox-text">
          <h3 class="text-white text-lg font-bold uppercase tracking-widest">{item.title}</h3>
        </div>
        <a href="#gallery" class="lightbox-close-btn">&times;</a>
      </div>
    </div>
  ))}
<Contact
    id="contact"
    title="Inquiries"
    subtitle="For exhibition requests or print inquiries, please reach out below."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    button="Send Message"
  />
</Layout>
<style is:global>
  /* LIGHTBOX LOGIC */
  .lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
  }

  /* Show when URL hash matches ID */
  .lightbox-overlay:target {
    display: flex;
  }

  .lightbox-wrapper {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-img {
    max-height: 80vh;
    width: auto;
    object-fit: contain;
    border: 1px solid #333;
  }

  .lightbox-text {
    padding: 1.5rem;
    text-align: center;
  }

  .lightbox-bg-close {
    position: absolute;
    inset: 0;
    cursor: default;
  }

  .lightbox-close-btn {
    position: absolute;
    top: -50px;
    right: 0;
    color: white;
    font-size: 40px;
    text-decoration: none;
  }
</style>
